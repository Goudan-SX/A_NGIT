# ==========================================================================
# 反诈卫士环境变量示例：复制为 .env 后按需修改
# 详细配置说明见 DEPLOY.md
# ==========================================================================

# 服务监听
APP_HOST=0.0.0.0
APP_PORT=8000

# SQL Server（默认本机 LocalDB，会自动建库建表）
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=(localdb)\MSSQLLocalDB
DB_NAME=AntiFraudGuard
DB_TRUSTED=yes
DB_ENCRYPT=no
# 使用账号密码登录正式 SQL Server 时改为：
# DB_TRUSTED=no
# DB_USER=sa
# DB_PASSWORD=your_password

# DeepSeek（文本 + 视觉识别；主要 AI 引擎）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=90

# Qwen / 通义千问（语音 ASR 与备用多模态；不配置也可离线运行规则引擎）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max
QWEN_AUDIO_MODEL=qwen3-asr-flash
QWEN_TIMEOUT=60

# 上传限制
MAX_IMAGE_MB=10
MAX_AUDIO_MB=25

# 安全配置（均可留空，自动生成）
# AUTHORIZED_MACHINE_ID：机器指纹，绑定本地API令牌，防止跨设备调用
AUTHORIZED_MACHINE_ID=
# LOCAL_API_TOKEN：本地API访问令牌，留空则自动生成并写入 backend/data/.local_api_token
LOCAL_API_TOKEN=
